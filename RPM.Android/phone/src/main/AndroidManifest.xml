<?xml version="1.0" encoding="utf-8"?>
<!-- The permissions and the playback service are declared in the manifest of `:core`. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".PhoneApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/App_Name"
        android:networkSecurityConfig="@xml/network_security"
        android:supportsRtl="true"
        android:theme="@style/Theme.RpmPhone">

        <!-- Portrait only. Android 16 ignores this on screens 600 dp and wider, where the layout is
             stretched to fit. The configuration changes listed below are handled by Compose, so a
             rotation or a keyboard change does not recreate the activity and lose what is on screen. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
